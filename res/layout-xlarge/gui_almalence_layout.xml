    <LinearLayout
        android:id="@+id/hintLayout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/almalence_gui_hint_background"
        android:orientation="vertical"
        android:visibility="gone" >

        <RelativeLayout
            android:id="@+id/hint_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mainButtonHeight"
            android:layout_weight="1" >

            <ImageView
                android:id="@+id/arrowdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/paramsLayoutHeight"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:src="@drawable/gui_almalence_hint_arrowpull" >
            </ImageView>

            <TextView
                android:id="@+id/textDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/arrowdown"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="10dp"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:text="@string/layout_hint_top_center"
                android:textColor="#00B6E8"
                android:textSize="18sp" >
            </TextView>

            <ImageView
                android:id="@+id/arrowup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="@dimen/hintUpArrowTop"
                android:layout_marginTop="@dimen/hintUpArrowTop"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:src="@drawable/gui_almalence_hint_arrowup" >
            </ImageView>

            <TextView
                android:id="@+id/textTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/arrowup"
                android:layout_marginLeft="@dimen/hintUpArrowText"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:text="@string/layout_hint_top_left"
                android:textColor="#00B6E8"
                android:textSize="18sp" >
            </TextView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/hint_center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/mainButtonHeight"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_margin="20dp"
            android:layout_weight="1" >

            <ImageView
                android:id="@+id/arrowToLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/textCenter"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:src="@drawable/gui_almalence_hint_arrowtoleft" >
            </ImageView>

            <TextView
                android:id="@+id/textCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:text="@string/layout_hint_center"
                android:textColor="#00B6E8"
                android:textSize="18sp" >
            </TextView>

            <ImageView
                android:id="@+id/arrowToRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textCenter"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:src="@drawable/gui_almalence_hint_arrowtoright" >
            </ImageView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/hint_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mainButtonHeight"
            android:layout_weight="1" >

            <ImageView
                android:id="@+id/arrowDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_marginBottom="50dp"
                android:layout_marginRight="@dimen/hintDownArrowBottom"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:src="@drawable/gui_almalence_hint_arrowdown" >
            </ImageView>

            <TextView
                android:id="@+id/textDownHintBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/arrowDown"
                android:layout_marginBottom="@dimen/hintDownArrowText"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@+id/arrowDown"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:text="@string/layout_hint_bottom"
                android:textColor="#00B6E8"
                android:textSize="18sp" >
            </TextView>
        </RelativeLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/mode_help"
        android:layout_width="fill_parent"
        android:layout_height="700dip"
        android:layout_centerInParent="true"
        android:layout_margin="20dip"
        android:background="#FAFAFA"
        android:visibility="gone" >

        <TextView
            android:id="@+id/helpTextModeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="5dip"
            android:background="@android:color/transparent"
            android:textColor="#5A5E5E"
            android:textSize="17sp" >
        </TextView>

        <LinearLayout
            android:id="@+id/helpImageLayout"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/helpImage"
            android:layout_below="@+id/helpTextModeName"
            android:layout_margin="5dip"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/helpImage"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" >
            </ImageView>
        </LinearLayout>

        <ScrollView
            android:id="@+id/helpScroll"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/helpTextLayout"
            android:layout_below="@+id/helpImageLayout"
            android:layout_marginBottom="5dip" >

            <TextView
                android:id="@+id/helpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dip"
                android:background="@android:color/transparent"
                android:textColor="#5A5E5E"
                android:textSize="17sp" >
            </TextView>
        </ScrollView>

        <RelativeLayout
            android:id="@+id/helpTextLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="2dip"
            android:orientation="horizontal"
            android:paddingBottom="5dip"
            android:paddingTop="5dip" >

            <LinearLayout
                android:id="@+id/helpButtonsLayout"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dip"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/buttonOk"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dip"
                    android:layout_weight="1"
                    android:text="@string/okText"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" >
                </Button>

                <Button
                    android:id="@+id/buttonDontShow"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dip"
                    android:layout_weight="1"
                    android:text="@string/helpTextDontShow"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" >
                </Button>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>