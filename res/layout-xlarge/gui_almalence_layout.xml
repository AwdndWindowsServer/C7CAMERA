<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guiAlmalenceLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical" >

    <RelativeLayout
        android:id="@+id/changeModeToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:visibility="gone" >
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/topPanel"
        android:layout_marginTop="@dimen/buttonsLayoutMarginTop" >

        <LinearLayout
            android:id="@+id/evLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dip"
            android:background="@drawable/ev_background"
            android:orientation="horizontal"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:paddingTop="10dip"
            android:visibility="gone" >

            <ImageButton
                android:id="@+id/evMinusButton"
                android:layout_width="@dimen/exposureButtonSize"
                android:layout_height="@dimen/exposureButtonSize"
                android:layout_marginRight="5dip"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:scaleType="fitCenter"
                android:src="@drawable/button_evminus" />

            <LinearLayout
                android:id="@+id/seekbarLayout"
                android:layout_width="@dimen/exposureSeekBarWidth"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <SeekBar
                    android:id="@+id/evSeekBar"
                    android:layout_width="@dimen/exposureSeekBarWidth"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:id="@+id/seekbartextLayout"
                    android:layout_width="@dimen/exposureSeekBarWidth"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                    <TextView
                        android:id="@+id/seekBarLeftText"
                        android:layout_width="@dimen/exposureTitleWidth"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="left"
                        android:layout_marginLeft="-10dp"
                        android:layout_marginRight="10dp"
                        android:textSize="@dimen/exposureTitleSize"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/seekBarCenterText"
                        android:layout_width="@dimen/exposureCenterTitleWidth"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/ev_zero"
                        android:textSize="@dimen/exposureTitleSize"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/seekBarRightText"
                        android:layout_width="@dimen/exposureTitleWidth"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="right"
                        android:layout_marginLeft="10dp"
                        android:textSize="@dimen/exposureTitleSize"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/evPlusButton"
                android:layout_width="@dimen/exposureButtonSize"
                android:layout_height="@dimen/exposureButtonSize"
                android:layout_marginLeft="5dip"
                android:background="@android:color/transparent"
                android:onClick="onButtonClick"
                android:scaleType="fitCenter"
                android:src="@drawable/button_evplus" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/scenemodeLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/scenemodeGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/wbLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/wbGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/focusmodeLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/focusmodeGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/flashmodeLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/flashmodeGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/isoLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/isoGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/meteringLayout"
            android:layout_width="@dimen/modeLayoutWidth"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/meteringmodeGrid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:numColumns="4"
                android:stretchMode="columnWidth"
                android:verticalSpacing="5dp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/cameraLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="5dip"
            android:background="@drawable/blacktransparentlayersettings"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone" >

            <GridView
                android:id="@+id/cameramodeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:stretchMode="columnWidth" />
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/vfLayout"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/mainButtons"
        android:layout_gravity="bottom|right"
        android:orientation="vertical"
        android:visibility="gone" >
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/modeLayout"
        android:layout_width="@dimen/modeLayoutWidth"
        android:layout_height="wrap_content"
        android:layout_above="@+id/mainButtons"
        android:layout_alignParentRight="true"
        android:layout_gravity="bottom"
        android:layout_marginRight="5dp"
        android:background="@drawable/blacktransparentlayerpulldownmenu"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone" >

        <GridView
            android:id="@+id/modeGrid"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:gravity="center"
            android:horizontalSpacing="5dp"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- -+-  -->

    <com.almalence.ui.Panel
        xmlns:my="http://schemas.android.com/apk/res/com.almalence.opencam"
        android:id="@+id/topPanel"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        my:animationDuration="30"
        my:closedHandle="@drawable/gui_almalence_handle_down"
        my:downSpace="@dimen/paramsLayoutHeight"
        my:linearFlying="true"
        my:openedHandle="@drawable/gui_almalence_handle_up"
        my:position="top" >

        <ImageButton
            android:id="@id/panelHandle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/paramsLayoutHeight"
            android:background="@drawable/blacktransparentlayerpulldownmenu"
            android:paddingBottom="5dip" />

        <LinearLayout
            android:id="@id/panelContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/blacktransparentlayerpulldownmenu"
            android:orientation="vertical" >

            <include layout="@layout/gui_almalence_panel" />
        </LinearLayout>
    </com.almalence.ui.Panel>
